# Copie para .env só para testar no seu computador:
#   set -a && source .env && set +a && npm run dry-run
# No GitHub, esses valores vão em Settings → Secrets and variables → Actions. NUNCA faça commit do .env.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

CF_ACCOUNT_ID=
CF_KV_NAMESPACE_ID=
CF_API_TOKEN=

GEMINI_API_KEY=
GROQ_API_KEY=
APIFY_TOKEN=

# Opcionais
# GEMINI_MODEL=gemini-2.5-flash-lite
# GROQ_MODEL=openai/gpt-oss-120b
# LOG_JOBS=1        # mostra título/empresa/nota de cada vaga no log (o log é público!)
# DRY_RUN=1         # não envia nada ao Telegram e não grava no KV
